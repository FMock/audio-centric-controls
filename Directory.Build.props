<Project>
  <!--
    Shared build settings for every project in the repository.
    Only x64 Debug/Release are supported. Output goes to bin\<Platform>\<Configuration>\ at the repo root.
  -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>

    <!-- Default to x64 when built outside the solution (e.g. `dotnet build path\to\proj.csproj`). -->
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU' Or '$(Platform)' == 'Any CPU'">x64</Platform>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>

    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <OutputPath>$(RepoRoot)bin\$(Platform)\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <Version>0.1.0</Version>
    <Authors>Audio-Centric-Controls contributors</Authors>
    <Product>Audio-Centric-Controls</Product>
    <Copyright>Copyright (c) Audio-Centric-Controls contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/FMock/audio-centric-controls</RepositoryUrl>
  </PropertyGroup>

  <!--
    NuGet packaging (only AudioCentric.Controls.Core and AudioCentric.Controls.Wpf are packable).
    `dotnet pack -c Release` writes .nupkg/.snupkg files to bin\x64\Release\packages\.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <PackageOutputPath>$(OutputPath)packages\</PackageOutputPath>
    <PackageProjectUrl>https://github.com/FMock/audio-centric-controls</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>audio;wpf;vu-meter;peak-meter;knob;fader;oscilloscope;spectrum-analyzer;waveform;eq;dsp;controls</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Source Link (built into the .NET 8 SDK) plus a symbol package, so consumers can step into the controls. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
