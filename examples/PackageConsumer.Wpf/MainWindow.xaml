<Window x:Class="PackageConsumer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:acc="https://github.com/FMock/audio-centric-controls"
        Title="Audio-Centric-Controls · package consumer" Width="1180" Height="820" Background="#FF141514">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9AA89E" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <!-- Measurements in: VU and dBFS, with the overload lamp latched by the control and reset through its command. -->
            <StackPanel>
                <acc:AnalogMeter x:Name="Vu" MeterType="Vu" Width="250" Height="250" Value="{Binding VuLeft}"
                                 IsOverloaded="{Binding Overload}" OverloadLabel="PEAK" IsBacklightEnabled="{Binding PowerActual}" />
                <TextBlock Text="VU" />
            </StackPanel>
            <StackPanel Margin="12,0,0,0">
                <acc:AnalogMeter x:Name="Peak" MeterType="Peak" Width="250" Height="250" Value="{Binding PeakLeft}"
                                 IsOverloaded="{Binding Overload}" IsPeakHoldEnabled="True" IsBacklightEnabled="{Binding PowerActual}" />
                <TextBlock Text="Sample peak" />
            </StackPanel>

            <StackPanel Margin="24,0,0,0" Width="560">
                <acc:LedBarMeter Height="44" ChannelCount="2" ShowScaleLabels="True"
                                 Value="{Binding PeakLeft}" Value2="{Binding PeakRight}" IsClipping="{Binding Overload}" />
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <!-- Parameters out: two-way bindings publish targets to the host. -->
                    <StackPanel>
                        <acc:RotaryKnob Width="84" Height="84" Minimum="-24" Maximum="24" Detent="0" Step="0.5" Unit="dB" Value="{Binding TrimDb}" />
                        <TextBlock Text="TRIM" />
                    </StackPanel>
                    <StackPanel Margin="18,0,0,0" Width="250">
                        <acc:ConsoleFader Orientation="Horizontal" Height="60" ValueDb="{Binding FaderDb}" />
                        <TextBlock Text="FADER" />
                    </StackPanel>
                    <StackPanel Margin="18,8,0,0">
                        <!-- Requested (IsChecked) vs actual (ActualState): the lamp follows the engine, and Pending shows the gap. -->
                        <acc:IlluminatedToggle ShowPowerIcon="True" OnLabel="Power" Width="120"
                                               IsChecked="{Binding PowerRequested}" ActualState="{Binding PowerActual}" Status="{Binding PowerStatus}" />
                        <acc:IlluminatedToggle OnLabel="Reset lamps" Mode="Momentary" LampColor="#FFFFB01E" Margin="0,8,0,0"
                                               Command="{x:Static acc:AnalogMeter.ResetOverloadCommand}" CommandTarget="{Binding ElementName=Vu}" Click="OnResetPeak" />
                    </StackPanel>
                </StackPanel>
                <acc:CorrelationMeter Height="120" HorizontalAlignment="Left" Margin="0,18,0,0" Correlation="{Binding Correlation}"
                                      MonoCheckCommand="{Binding MonoCheckCommand}" IsMonoActive="{Binding IsMono}" IsBacklightEnabled="{Binding PowerActual}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Snapshots in: the host supplies analysed frames; the control owns axes, bands, averaging and peak hold. -->
            <acc:SpectrumAnalyzer Spectrum="{Binding Spectrum}" DisplayMode="Bars" AveragingTime="0.2" />
            <!-- Requests out, acknowledged response in: dragging a handle runs BandChangeCommand; the host clamps to ±12 dB. -->
            <acc:FrequencyResponseGraph Grid.Column="2" Response="{Binding Response}" Bands="{Binding Bands}"
                                        BandChangeCommand="{Binding BandChangeCommand}" SelectedBandIndex="1" MinimumDb="-15" MaximumDb="15" />
        </Grid>
    </Grid>
</Window>
