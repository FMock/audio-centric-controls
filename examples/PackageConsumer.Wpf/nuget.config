<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The locally packed Audio-Centric-Controls packages (dotnet pack -c Release), then nuget.org for anything else. -->
  <packageSources>
    <clear />
    <add key="local-acc" value="..\..\bin\x64\Release\packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-acc">
      <package pattern="AudioCentric.Controls.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
