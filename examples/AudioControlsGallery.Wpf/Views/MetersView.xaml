<UserControl x:Class="AudioControlsGallery.Views.MetersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:acc="https://github.com/FMock/audio-centric-controls"
             xmlns:vm="clr-namespace:AudioControlsGallery.ViewModels"
             xmlns:scales="clr-namespace:AudioCentric.Controls.Scales;assembly=AudioCentric.Controls.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28">

            <!-- Analog meters -->
            <Border Style="{StaticResource ConsolePanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Analog meters · channel 1" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="6">
                                <acc:AnalogMeter Height="260" MeterType="Vu" Value="{Binding VuLeft}"
                                                 IsOverloaded="{Binding OverloadLeft}" OverloadLabel="PEAK"
                                                 NeedleDynamics="{Binding NeedleDynamics}" OverloadLatchMode="{Binding LatchMode}"
                                                 FaceColor="{Binding Face.Color}" BacklightIntensity="{Binding Backlight}"
                                                 IsBacklightEnabled="{Binding IsPowered}" />
                                <TextBlock Text="{Binding VuText}" Style="{StaticResource Readout}" />
                                <TextBlock Text="VU · calibrated by the provider" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <StackPanel Margin="6">
                                <acc:AnalogMeter Height="260" MeterType="{Binding PeakMeterType}" Value="{Binding PeakLeft}"
                                                 IsOverloaded="{Binding OverloadLeft}" IsPeakHoldEnabled="{Binding PeakHold}"
                                                 NeedleDynamics="{Binding NeedleDynamics}" OverloadLatchMode="{Binding LatchMode}"
                                                 FaceColor="{Binding Face.Color}" BacklightIntensity="{Binding Backlight}"
                                                 IsBacklightEnabled="{Binding IsPowered}" />
                                <TextBlock Text="{Binding PeakText}" Style="{StaticResource Readout}" />
                                <TextBlock Text="Sample peak · 20 dB/s release" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <StackPanel Margin="6">
                                <acc:AnalogMeter Height="260" MeterType="Rms" Value="{Binding RmsLeft}"
                                                 ShowOverloadLamp="False"
                                                 NeedleDynamics="{Binding NeedleDynamics}"
                                                 FaceColor="{Binding Face.Color}" BacklightIntensity="{Binding Backlight}"
                                                 IsBacklightEnabled="{Binding IsPowered}" />
                                <TextBlock Text="{Binding RmsText}" Style="{StaticResource Readout}" />
                                <TextBlock Text="RMS · 300 ms window" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Options -->
                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                        <TextBlock Text="Needle" Style="{StaticResource Caption}" HorizontalAlignment="Left" Margin="0,0,0,6" />
                        <WrapPanel>
                            <RadioButton Style="{StaticResource Segment}" GroupName="Needle" Content="Mechanical"
                                         IsChecked="{Binding NeedleDynamics, Converter={StaticResource EnumEquals}, ConverterParameter=Mechanical}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="Needle" Content="None (exact)"
                                         IsChecked="{Binding NeedleDynamics, Converter={StaticResource EnumEquals}, ConverterParameter=None}" />
                        </WrapPanel>

                        <TextBlock Text="Overload lamp" Style="{StaticResource Caption}" HorizontalAlignment="Left" Margin="0,12,0,6" />
                        <WrapPanel>
                            <RadioButton Style="{StaticResource Segment}" GroupName="Latch" Content="Latched"
                                         IsChecked="{Binding LatchMode, Converter={StaticResource EnumEquals}, ConverterParameter=Latched}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="Latch" Content="Hold 2 s"
                                         IsChecked="{Binding LatchMode, Converter={StaticResource EnumEquals}, ConverterParameter=HoldTime}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="Latch" Content="Momentary"
                                         IsChecked="{Binding LatchMode, Converter={StaticResource EnumEquals}, ConverterParameter=Momentary}" />
                        </WrapPanel>
                        <acc:IlluminatedToggle HorizontalAlignment="Left" Margin="0,4,0,0" Mode="Momentary" OnLabel="Reset lamps"
                                               LampColor="#FFFFB01E" Click="OnResetOverload" />

                        <TextBlock Text="Peak scale" Style="{StaticResource Caption}" HorizontalAlignment="Left" Margin="0,12,0,6" />
                        <WrapPanel>
                            <RadioButton Style="{StaticResource Segment}" GroupName="PeakScale" Content="dBFS to +6"
                                         IsChecked="{Binding PeakMeterType, Converter={StaticResource EnumEquals}, ConverterParameter=Peak}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="PeakScale" Content="PCM to 0"
                                         IsChecked="{Binding PeakMeterType, Converter={StaticResource EnumEquals}, ConverterParameter=PeakPcm}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="PeakScale" Content="dBTP"
                                         IsChecked="{Binding PeakMeterType, Converter={StaticResource EnumEquals}, ConverterParameter=TruePeak}" />
                        </WrapPanel>

                        <TextBlock Text="Dial" Style="{StaticResource Caption}" HorizontalAlignment="Left" Margin="0,12,0,6" />
                        <ItemsControl ItemsSource="{x:Static vm:GalleryViewModel.FaceOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Face" Content="{Binding Name}"
                                                 Checked="OnFaceChecked" Tag="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <StackPanel>
                                <acc:RotaryKnob Width="64" Height="64" Minimum="0" Maximum="1" DefaultValue="1" Value="{Binding Backlight}" />
                                <TextBlock Text="BACKLIGHT" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <acc:IlluminatedToggle OnLabel="Peak hold" IsChecked="{Binding PeakHold}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stereo VU pair -->
            <Border Style="{StaticResource ConsolePanel}">
                <StackPanel>
                    <TextBlock Text="Stereo VU pair" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel Margin="8">
                            <acc:AnalogMeter Width="210" Height="210" MeterType="Vu" Value="{Binding VuLeft}" IsOverloaded="{Binding OverloadLeft}"
                                             OverloadLabel="L" NeedleDynamics="{Binding NeedleDynamics}" OverloadLatchMode="{Binding LatchMode}"
                                             FaceColor="{Binding Face.Color}" BacklightIntensity="{Binding Backlight}" IsBacklightEnabled="{Binding IsPowered}" />
                            <TextBlock Text="{Binding VuLeft, Converter={StaticResource LevelText}, ConverterParameter=VU}" Style="{StaticResource Readout}" FontSize="13" />
                        </StackPanel>
                        <StackPanel Margin="8">
                            <acc:AnalogMeter Width="210" Height="210" MeterType="Vu" Value="{Binding VuRight}" IsOverloaded="{Binding OverloadRight}"
                                             OverloadLabel="R" NeedleDynamics="{Binding NeedleDynamics}" OverloadLatchMode="{Binding LatchMode}"
                                             FaceColor="{Binding Face.Color}" BacklightIntensity="{Binding Backlight}" IsBacklightEnabled="{Binding IsPowered}" />
                            <TextBlock Text="{Binding VuRight, Converter={StaticResource LevelText}, ConverterParameter=VU}" Style="{StaticResource Readout}" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- LED meters -->
            <Border Style="{StaticResource ConsolePanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="LED bar meters" Style="{StaticResource SectionTitle}" Margin="0" />
                            <acc:IlluminatedToggle DockPanel.Dock="Right" HorizontalAlignment="Right" OnLabel="Dot mode" IsChecked="{Binding LedDotMode}" />
                        </DockPanel>
                        <TextBlock Text="Stereo sample peak, 24 segments, peak hold, clip LED (click it to reset)" Style="{StaticResource Note}" Margin="0,0,0,6" />
                        <acc:LedBarMeter Height="44" ChannelCount="2" ShowScaleLabels="True" Value="{Binding PeakLeft}" Value2="{Binding PeakRight}"
                                         IsClipping="{Binding Overload}" IsDotMode="{Binding LedDotMode}" />
                        <TextBlock Text="Design-reference thresholds (−60 … 0 dBFS, 11 segments), mono" Style="{StaticResource Note}" Margin="0,16,0,6" />
                        <acc:LedBarMeter Height="30" ShowScaleLabels="True" Value="{Binding PeakLeft}" IsClipping="{Binding OverloadLeft}"
                                         Scale="{x:Static scales:ScalePresets.LedPeak}" IsDotMode="{Binding LedDotMode}" />
                        <TextBlock Text="RMS reading on the same bar (no display release; the provider sets the dynamics)" Style="{StaticResource Note}" Margin="0,16,0,6" />
                        <acc:LedBarMeter Height="30" ShowScaleLabels="True" MeterMode="Rms" ShowClipLed="False" IsPeakHoldEnabled="False"
                                         Value="{Binding RmsLeft}" IsDotMode="{Binding LedDotMode}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="28,0,0,0">
                        <StackPanel>
                            <acc:LedBarMeter Orientation="Vertical" Height="260" ChannelCount="2" ShowScaleLabels="True"
                                             Value="{Binding PeakLeft}" Value2="{Binding PeakRight}" IsClipping="{Binding Overload}" IsDotMode="{Binding LedDotMode}" />
                            <TextBlock Text="PEAK L R" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Margin="18,0,0,0">
                            <acc:LedBarMeter Orientation="Vertical" Height="260" ChannelCount="2" ShowScaleLabels="True" MeterMode="Rms"
                                             ShowClipLed="False" IsPeakHoldEnabled="False"
                                             Value="{Binding RmsLeft}" Value2="{Binding RmsRight}" IsDotMode="{Binding LedDotMode}" />
                            <TextBlock Text="RMS L R" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
