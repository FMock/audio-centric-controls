<UserControl x:Class="AudioControlsGallery.Views.InputsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:acc="https://github.com/FMock/audio-centric-controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28">

            <!-- Knobs -->
            <Border Style="{StaticResource ConsolePanel}">
                <StackPanel>
                    <TextBlock Text="Rotary knobs" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,14"
                               Text="Drag vertically (Shift = fine), use the wheel or arrow keys, double-click to reset. Each knob publishes a target value; the mapping and its inverse live in Core." />
                    <WrapPanel>
                        <StackPanel Margin="0,0,34,0">
                            <acc:RotaryKnob x:Name="GainKnob" Width="100" Height="100" Minimum="-24" Maximum="24" Detent="0" Step="0.5" Unit="dB"
                                            Value="{Binding InputTrimDb}" />
                            <TextBlock Text="GAIN · drives the engine" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Value, ElementName=GainKnob, Converter={StaticResource LevelText}, ConverterParameter=dB}" Style="{StaticResource Readout}" FontSize="13" />
                        </StackPanel>
                        <StackPanel Margin="0,0,34,0">
                            <acc:RotaryKnob x:Name="FreqKnob" Width="100" Height="100" Minimum="20" Maximum="20000" Mapping="Logarithmic"
                                            DefaultValue="632.46" Value="1000" Unit="Hz" />
                            <TextBlock Text="FREQ · log 20 Hz–20 kHz" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Value, ElementName=FreqKnob, Converter={StaticResource LevelText}, ConverterParameter=Hz}" Style="{StaticResource Readout}" FontSize="13" />
                        </StackPanel>
                        <StackPanel Margin="0,0,34,0">
                            <acc:RotaryKnob x:Name="QKnob" Width="100" Height="100" Minimum="0.1" Maximum="10" Mapping="Logarithmic"
                                            DefaultValue="0.707" Value="0.707" />
                            <TextBlock Text="Q · log 0.1–10" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Value, ElementName=QKnob, StringFormat={}{0:0.00}}" Style="{StaticResource Readout}" FontSize="13" />
                        </StackPanel>
                        <StackPanel Margin="0,0,34,0">
                            <acc:RotaryKnob x:Name="PanKnob" Width="100" Height="100" Minimum="-1" Maximum="1" Detent="0" IndicatorColor="#FFFFB01E" />
                            <TextBlock Text="PAN · centre detent" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Value, ElementName=PanKnob, Converter={StaticResource LevelText}, ConverterParameter=pan}" Style="{StaticResource Readout}" FontSize="13" />
                        </StackPanel>
                        <StackPanel Margin="0,0,34,0">
                            <acc:RotaryKnob x:Name="MixKnob" Width="72" Height="72" Minimum="0" Maximum="1" DefaultValue="1" Value="0.35" TickCount="5"
                                            IndicatorColor="#FF7CC8F0" Margin="14" />
                            <TextBlock Text="MIX · small" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Value, ElementName=MixKnob, Converter={StaticResource LevelText}, ConverterParameter=%}" Style="{StaticResource Readout}" FontSize="13" />
                        </StackPanel>
                        <StackPanel>
                            <acc:RotaryKnob x:Name="StepKnob" Width="72" Height="72" Minimum="1" Maximum="8" Step="1" DefaultValue="4" Value="4"
                                            TickCount="8" ShowValueArc="False" Margin="14" />
                            <TextBlock Text="RATIO · stepped" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Value, ElementName=StepKnob, StringFormat={}{0:0}:1}" Style="{StaticResource Readout}" FontSize="13" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Faders -->
            <Border Style="{StaticResource ConsolePanel}">
                <StackPanel>
                    <TextBlock Text="Console faders" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,14"
                               Text="Taper anchors (position, dB): (0, −∞), (0.05, −60), (0.25, −30), (0.5, −12), (0.75, 0 = unity), (1, +10). Click the track to jump, drag the cap, double-click for unity." />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,24,0">
                            <acc:ConsoleFader Height="300" ValueDb="{Binding FaderDb}" IsMuted="{Binding IsMuted}" />
                            <acc:IlluminatedToggle SwitchStyle="SquareCap" Width="36" Height="36" Margin="0,8,0,0" OnLabel="MUTE"
                                                   LampColor="#FFFF3A26" IsChecked="{Binding IsMuted}" />
                            <TextBlock Text="CH 1 · engine" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding FaderText}" Style="{StaticResource Readout}" FontSize="13" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <acc:ConsoleFader x:Name="Ch2" Height="300" ValueDb="-12" IsMuted="{Binding IsChecked, ElementName=Ch2Mute}" />
                            <acc:IlluminatedToggle x:Name="Ch2Mute" SwitchStyle="SquareCap" Width="36" Height="36" Margin="0,8,0,0" OnLabel="MUTE" LampColor="#FFFF3A26" />
                            <TextBlock Text="CH 2" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding ValueDb, ElementName=Ch2, Converter={StaticResource LevelText}, ConverterParameter=dB}" Style="{StaticResource Readout}" FontSize="13" />
                        </StackPanel>
                        <StackPanel Margin="0,0,40,0">
                            <acc:ConsoleFader x:Name="Ch3" Height="300" ValueDb="5" IndicatorColor="#FFFFB01E" />
                            <acc:IlluminatedToggle SwitchStyle="SquareCap" Width="36" Height="36" Margin="0,8,0,0" OnLabel="SOLO" LampColor="#FFFFD21E" />
                            <TextBlock Text="BUS" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding ValueDb, ElementName=Ch3, Converter={StaticResource LevelText}, ConverterParameter=dB}" Style="{StaticResource Readout}" FontSize="13" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Width="420">
                            <TextBlock Text="Horizontal" Style="{StaticResource Caption}" HorizontalAlignment="Left" />
                            <acc:ConsoleFader x:Name="HFader" Orientation="Horizontal" Height="70" ValueDb="-6" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding ValueDb, ElementName=HFader, Converter={StaticResource LevelText}, ConverterParameter=dB}" Style="{StaticResource Readout}" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Switches -->
            <Border Style="{StaticResource ConsolePanel}">
                <StackPanel>
                    <TextBlock Text="Illuminated switches" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,14"
                               Text="A switch sends a request; the lamp shows the state the host acknowledged. Space toggles the focused switch." />
                    <WrapPanel>
                        <StackPanel Margin="0,0,28,14">
                            <acc:IlluminatedToggle ShowPowerIcon="True" OnLabel="Power on" OffLabel="Power off" Width="132" IsChecked="{Binding IsPowered}" />
                            <TextBlock Text="Push · latching" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,28,14">
                            <acc:IlluminatedToggle OnLabel="Bypass" IsChecked="True" LampColor="#FFFFB01E" />
                            <TextBlock Text="Push · amber" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,28,14">
                            <acc:IlluminatedToggle OnLabel="Talkback" Mode="Momentary" LampColor="#FF7CC8F0" />
                            <TextBlock Text="Push · momentary" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,14">
                            <acc:IlluminatedToggle SwitchStyle="SquareCap" Width="48" Height="48" OnLabel="SOLO" LampColor="#FFFFD21E" />
                            <TextBlock Text="Solo" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,14">
                            <acc:IlluminatedToggle SwitchStyle="SquareCap" Width="48" Height="48" OnLabel="MUTE" LampColor="#FFFF3A26" IsChecked="{Binding IsMuted}" />
                            <TextBlock Text="Mute · CH 1" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,28,14">
                            <acc:IlluminatedToggle SwitchStyle="SquareCap" Width="48" Height="48" OnLabel="REC" LampColor="#FFFF2E1E" />
                            <TextBlock Text="Record arm" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,14">
                            <acc:IlluminatedToggle SwitchStyle="Lever" Width="56" Height="96" OnLabel="+48V" LampColor="#FFFF2E1E" />
                            <TextBlock Text="Lever" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,28,14">
                            <acc:IlluminatedToggle SwitchStyle="Lever" Width="56" Height="96" OnLabel="PHASE" IsChecked="True" />
                            <TextBlock Text="Lever" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,14">
                            <acc:IlluminatedToggle x:Name="SlowSwitch" OnLabel="Oversample" Checked="OnSlowSwitchChanged" Unchecked="OnSlowSwitchChanged" />
                            <TextBlock Text="Acknowledged after 0.8 s" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,14">
                            <acc:IlluminatedToggle x:Name="FaultSwitch" OnLabel="Ext. sync" Checked="OnFaultSwitchChanged" Unchecked="OnFaultSwitchChanged" />
                            <TextBlock Text="Host reports a fault" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
